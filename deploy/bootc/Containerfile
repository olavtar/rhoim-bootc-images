# =============================================================================
# RHOIM Bootc Containerfile - vLLM Model Serving (RHEL 9 bootc)
# =============================================================================
# Base: RHEL 9 bootc, requires:
#   podman login registry.redhat.io
# Build (Linux x86_64 recommended):
#   podman build --platform linux/amd64 -t localhost/rhoim-bootc:latest -f Containerfile .
# =============================================================================

FROM registry.redhat.io/rhel9/rhel-bootc:latest

# Ensure pip is available without needing dnf/rpm-ostree (no subscription).
RUN python3 -m ensurepip --upgrade || \
    (curl -sSL https://bootstrap.pypa.io/get-pip.py | python3) || \
    (curl -sSL https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py && python3 /tmp/get-pip.py)

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

# -----------------------------------------------------------------------------
# Create app user + layout
# -----------------------------------------------------------------------------
RUN useradd -m -d /opt/rhoim -u 1001 rhoim \
    && mkdir -p /opt/rhoim/{bin,models,gateway} /etc/sysconfig \
    && chown -R rhoim:rhoim /opt/rhoim

WORKDIR /opt/rhoim

# -----------------------------------------------------------------------------
# Python venv + packages (CPU vLLM in-image; GPU via RHAIIS image)
# -----------------------------------------------------------------------------
COPY requirements.txt /opt/rhoim/requirements.txt

# Create venv and install deps into it
RUN python3 -m venv /opt/rhoim/venv \
    && /opt/rhoim/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    # Install CPU PyTorch from the official CPU index
    && /opt/rhoim/venv/bin/pip install --no-cache-dir \
         torch torchvision torchaudio \
         --index-url https://download.pytorch.org/whl/cpu \
    # Common Python deps (HF, FastAPI, etc.)
    && /opt/rhoim/venv/bin/pip install --no-cache-dir -r /opt/rhoim/requirements.txt \
    # vLLM itself (CPU-capable; we set VLLM_NO_CUDA=1 at runtime when needed)
    && /opt/rhoim/venv/bin/pip install --no-cache-dir --ignore-installed "vllm==0.6.*"

ENV PATH="/opt/rhoim/venv/bin:${PATH}"

# -----------------------------------------------------------------------------
# Default env (can be overridden via /etc/sysconfig/rhoim)
# -----------------------------------------------------------------------------
ENV MODEL_ID="TinyLlama/TinyLlama-1.1B-Chat-v1.0" \
    MODEL_PATH="/opt/rhoim/models" \
    VLLM_HOST="0.0.0.0" \
    VLLM_PORT="8000" \
    RHOIM_ACCELERATOR_MODE="auto" \
    MAX_MODEL_LEN="2048" \
    VLLM_LOGGING_LEVEL="INFO"

RUN mkdir -p "${MODEL_PATH}" && chown -R rhoim:rhoim "${MODEL_PATH}"
EXPOSE 8000

# -----------------------------------------------------------------------------
# Scripts + env
# -----------------------------------------------------------------------------
COPY launch-vllm.sh /opt/rhoim/bin/launch-vllm.sh
COPY gpu-detect.sh  /opt/rhoim/bin/gpu-detect.sh
COPY rhoim.env      /etc/sysconfig/rhoim

RUN chmod +x /opt/rhoim/bin/*.sh \
    && chown rhoim:rhoim /opt/rhoim/bin/*.sh

# -----------------------------------------------------------------------------
# Systemd units
# -----------------------------------------------------------------------------
COPY rhoim-vllm.service    /etc/systemd/system/rhoim-vllm.service
COPY rhoim-gateway.service /etc/systemd/system/rhoim-gateway.service

# bootc-friendly enable (no systemctl at build time)
RUN mkdir -p /etc/systemd/system/multi-user.target.wants \
    && ln -sf /etc/systemd/system/rhoim-vllm.service \
          /etc/systemd/system/multi-user.target.wants/rhoim-vllm.service \
    && ln -sf /etc/systemd/system/rhoim-gateway.service \
          /etc/systemd/system/multi-user.target.wants/rhoim-gateway.service

# -----------------------------------------------------------------------------
# Bootc entrypoint – systemd as PID 1
# -----------------------------------------------------------------------------
CMD ["/sbin/init"]
