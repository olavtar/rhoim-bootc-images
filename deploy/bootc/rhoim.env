# Model settings
MODEL_ID="TinyLlama/TinyLlama-1.1B-Chat-v1.0"
MODEL_PATH="/opt/rhoim/models"

# vLLM server bind
VLLM_HOST="0.0.0.0"
VLLM_PORT="8000"

# Mode: auto | gpu | cpu
RHOIM_ACCELERATOR_MODE="auto"

# Tuning (both modes)
MAX_MODEL_LEN="2048"
VLLM_LOGGING_LEVEL="INFO"

# RHAIIS vLLM CUDA image tag
VLLM_TAG="3.2.3"
