[Unit]
Description=RHOIM vLLM Model Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rhoim
Group=rhoim
EnvironmentFile=-/etc/sysconfig/rhoim
WorkingDirectory=/opt/rhoim
ExecStart=/opt/rhoim/bin/launch-vllm.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
