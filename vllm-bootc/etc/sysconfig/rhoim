# Hugging Face model ID to download
MODEL_ID="TinyLlama/TinyLlama-1.1B-Chat-v1.0"

# Persistent locations on the VM
MODELS_DIR="/var/lib/rhoim/models"
RHOIM_CACHE_DIR="/var/lib/rhoim/cache"

# Hugging Face / Transformers cache locations (used by huggingface-cli)
HF_HOME="/var/lib/rhoim/cache"
HF_HUB_CACHE="/var/lib/rhoim/cache"
TRANSFORMERS_CACHE="/var/lib/rhoim/cache"

# Optional token (needed only for gated/private models)
# HUGGING_FACE_HUB_TOKEN="..."

# vLLM listen
VLLM_HOST="0.0.0.0"
VLLM_PORT="8000"

# Optional extra args
VLLM_EXTRA_ARGS=""
