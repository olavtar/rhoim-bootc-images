# RHOIM Environment Variables for bootc Model Serving (RHAIIS container)

# Model identifier (used by the Quadlet Exec/Command)
VLLM_MODEL="TinyLlama/TinyLlama-1.1B-Chat-v1.0"

# Host paths (these are mounted into the container)
# Host: /var/lib/rhoim/models  -> Container: /models
# Host: /var/lib/rhoim/cache   -> Container: /opt/app-root/src/.cache
RHOIM_MODELS_DIR="/var/lib/rhoim/models"
RHOIM_CACHE_DIR="/var/lib/rhoim/cache"

# Network config (optional unless you wire them into Exec/Command)
VLLM_PORT="8000"
VLLM_HOST="0.0.0.0"

# Optional: extra args passed to vLLM OpenAI API server
VLLM_EXTRA_ARGS=""

# Optional: HF auth / offline behavior (only needed if container downloads)
# HUGGING_FACE_HUB_TOKEN="..."
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# --- Gateway/API Configuration (if you still use it elsewhere) ---
API_KEYS="devkey1,devkey2"
