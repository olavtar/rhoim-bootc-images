[Unit]
Description=RHOIM vLLM (RHAIIS container)
After=network-online.target rhoim-model-prefetch.service
Wants=network-online.target rhoim-model-prefetch.service

[Container]
Image=registry.redhat.io/rhaiis/vllm-cuda-rhel9:latest
PublishPort=8000:8000

Volume=/var/lib/rhoim/models:/models:Z
Volume=/var/lib/rhoim/cache:/opt/app-root/src/.cache:Z

EnvironmentFile=/etc/sysconfig/rhoim

PodmanArgs=--pids-limit=0
PodmanArgs=--security-opt=label=disable

# For a REAL VM with NVIDIA CDI configured, enable this:
PodmanArgs=--device nvidia.com/gpu=all

# Serve from the local model path created by prefetch
Exec=--model /models/${MODEL_ID} --host ${VLLM_HOST} --port ${VLLM_PORT} ${VLLM_EXTRA_ARGS}

[Service]
Restart=always
RestartSec=2
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
