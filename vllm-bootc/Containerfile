# =============================================================================
# Stage 1: Builder – UBI, build venv with vLLM + deps
# =============================================================================
FROM registry.access.redhat.com/ubi9/ubi:latest AS builder

ARG PYTHON_VERSION=3.11
ARG VLLM_VERSION=0.11.*
ARG ACCELERATOR=cpu   # cpu | cuda
ARG TORCH_VERSION=2.5.1

SHELL ["/bin/bash", "-c"]

RUN dnf -y install \
      python${PYTHON_VERSION} \
      python${PYTHON_VERSION}-pip \
      git jq which procps-ng \
  && dnf clean all

# Create venv
RUN python${PYTHON_VERSION} -m venv /opt/vllm-venv

ENV PATH="/opt/vllm-venv/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install torch (CPU or CUDA) + vLLM
RUN if [[ "${ACCELERATOR}" == "cuda" ]]; then \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu121 \
        torch==${TORCH_VERSION}+cu121 torchvision torchaudio ; \
    else \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==${TORCH_VERSION}+cpu torchvision torchaudio ; \
    fi

RUN pip install --no-cache-dir \
      "vllm==${VLLM_VERSION}" \
      "huggingface_hub>=0.24.0" \
      "requests" \
      "hf-transfer"

# Build-time sanity check
RUN python -c "import vllm, torch; print('vllm', vllm.__version__, 'torch', torch.__version__)"

# =============================================================================
# Stage 2: Final – bootc base, systemd units + venv
# =============================================================================
FROM registry.redhat.io/rhel9/rhel-bootc:latest

SHELL ["/bin/bash", "-c"]

# Runtime deps (rpm-ostree for bootc)
RUN rpm-ostree install \
      bash coreutils findutils procps-ng which jq \
      python3.11 shadow-utils \
  && rpm-ostree cleanup -m

# Ensure runtime dirs exist (ownership fixed at boot by sysusers/tmpfiles)
RUN mkdir -p /opt/rhoim/bin /opt/rhoim/models

# venv first on PATH at runtime
ENV PATH="/opt/vllm-venv/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

# Copy venv from builder
COPY --from=builder /opt/vllm-venv /opt/vllm-venv

# Entry point
COPY vllm/initializer-entrypoint.sh /opt/rhoim/bin/initializer-entrypoint.sh
RUN chmod 0755 /opt/rhoim/bin/initializer-entrypoint.sh

# sysusers (creates rhoim user at first boot)
COPY etc/sysusers.d/rhoim.conf /etc/sysusers.d/rhoim.conf

# sysconfig
COPY etc/sysconfig/rhoim /etc/sysconfig/rhoim

# systemd service
COPY etc/systemd/system/rhoim-vllm.service /etc/systemd/system/rhoim-vllm.service

# Enable service without systemctl (safe for image builds)
RUN mkdir -p /etc/systemd/system/multi-user.target.wants \
 && ln -sf ../rhoim-vllm.service \
    /etc/systemd/system/multi-user.target.wants/rhoim-vllm.service

EXPOSE 8000

LABEL org.osbuild.bootc=true \
      bootc=true

RUN bootc container lint

CMD ["/sbin/init"]