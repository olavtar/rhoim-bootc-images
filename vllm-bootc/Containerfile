FROM registry.redhat.io/rhel9/rhel-bootc:latest

RUN dnf -y install \
      systemd \
      podman \
      podman-plugins \
      jq \
      ca-certificates \
      cloud-init \
      sudo \
    && dnf clean all

# Enable cloud-init services for AWS
RUN systemctl enable cloud-init cloud-init-local cloud-config cloud-final

# Create ec2-user with sudo access and set password
# Use encrypted password hash for bootc compatibility (password: rhoim123)
RUN useradd -m -G wheel ec2-user && \
    echo 'root:$6$randomsalt$Vm.fV71RTQ218MBnpOtxkf10x6YNVQI0Ovye1HLaYV0ZdTvjpS1oGJMw1JUHcRWth1.fPzQIS4Rb7ImGGdTBn1' | chpasswd -e && \
    echo 'ec2-user:$6$randomsalt$Vm.fV71RTQ218MBnpOtxkf10x6YNVQI0Ovye1HLaYV0ZdTvjpS1oGJMw1JUHcRWth1.fPzQIS4Rb7ImGGdTBn1' | chpasswd -e && \
    echo "ec2-user ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/ec2-user && \
    chmod 440 /etc/sudoers.d/ec2-user

# Configure SSH to allow password authentication
RUN mkdir -p /etc/ssh/sshd_config.d && \
    printf '%s\n' \
      'PasswordAuthentication yes' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin yes' \
      'PermitEmptyPasswords no' \
      'ChallengeResponseAuthentication no' \
      'UsePAM yes' > /etc/ssh/sshd_config.d/50-password-auth.conf && \
    systemctl enable sshd.service

RUN mkdir -p \
      /etc/containers/systemd \
      /var/lib/rhoim/models \
      /var/lib/rhoim/cache \
    && chmod 755 /var/lib/rhoim /var/lib/rhoim/models /var/lib/rhoim/cache

COPY etc/sysconfig/rhoim /etc/sysconfig/rhoim
COPY etc/containers/systemd/rhoim-vllm.container /etc/containers/systemd/rhoim-vllm.container

COPY scripts/prefetch-model.sh /usr/local/bin/prefetch-model.sh
RUN chmod +x /usr/local/bin/prefetch-model.sh

COPY etc/systemd/system/rhoim-model-prefetch.service /etc/systemd/system/rhoim-model-prefetch.service

# Enable the oneshot at boot (symlink works during build)
RUN mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /etc/systemd/system/rhoim-model-prefetch.service \
      /etc/systemd/system/multi-user.target.wants/rhoim-model-prefetch.service

# Optional sysusers
COPY etc/sysusers.d/rhoim.conf /etc/sysusers.d/rhoim.conf
RUN systemd-sysusers || true

EXPOSE 8000
LABEL org.osbuild.bootc=true bootc=true
RUN bootc container lint || true
CMD ["/sbin/init"]
