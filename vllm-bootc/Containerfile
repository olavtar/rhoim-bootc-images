# =============================================================================
# RHOIM vLLM bootc appliance (GPU-only) built on RHAIIS vLLM CUDA RHEL9 image
# =============================================================================
FROM registry.redhat.io/rhaiis/vllm-cuda-rhel9:latest

# RHAIIS base image runs as non-root (USER 1001:0). We need root for RPM installs and system setup.
USER 0

# ---- Install what bootc+systemd appliance needs (keep minimal) ----
# NOTE: Depending on the RHAIIS image contents, some of these may already exist.
RUN dnf -y install \
      systemd \
      jq \
      procps-ng \
      which \
    && dnf clean all

# Install huggingface-cli, but keep huggingface_hub compatible with transformers in this stack
RUN python3 -m pip install --no-cache-dir --upgrade --force-reinstall \
    "huggingface_hub>=0.34.0,<1.0"


# ---- Runtime environment (keep your safety toggles) ----
ENV PYTHONUNBUFFERED=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1 \
    VLLM_USE_TORCH_COMPILE=0 \
    VLLM_USE_TRITON=0 \
    RHOIM_ACCELERATOR_MODE=gpu

# ---- RHOIM config + entrypoint ----
COPY etc/ /etc/
COPY vllm/initializer-entrypoint.sh /usr/local/bin/initializer-entrypoint.sh
RUN chmod +x /usr/local/bin/initializer-entrypoint.sh

# ---- Users + layout ----
# NOTE: `systemctl enable` can fail during container build (no running systemd).
# For bootc/systemd images, enabling via symlink is equivalent.
RUN systemd-sysusers && \
    mkdir -p /opt/rhoim/{bin,models,gateway} /tmp/models /sysroot && \
    chown -R rhoim:rhoim /opt/rhoim /tmp/models && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /usr/lib/systemd/system/rhoim-vllm.service /etc/systemd/system/multi-user.target.wants/rhoim-vllm.service

# ---- Verify vLLM exists in the base image (fail at build time if not) ----
RUN python3 -c "import vllm; import torch; print('vllm OK:', vllm.__version__, '| torch:', torch.__version__)" && \
    command -v nvidia-smi >/dev/null 2>&1 || true

EXPOSE 8000

# ---- bootc metadata ----
LABEL org.osbuild.bootc=true bootc=true
# If bootc is not present in the base image, do not fail the build.
RUN command -v bootc >/dev/null 2>&1 && bootc container lint || true

# Restore the base image default user (non-root, root group)
USER 1001:0

CMD ["/sbin/init"]
