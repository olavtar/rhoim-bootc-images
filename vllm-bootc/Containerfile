# =============================================================================
# Stage 1: Builder – UBI, build venv with vLLM + deps
# =============================================================================
FROM registry.access.redhat.com/ubi9/ubi:latest AS builder

ARG PYTHON_VERSION=3.11
ARG VLLM_VERSION=0.11.*
ARG ACCELERATOR=cpu   # cpu | cuda
ARG TORCH_VERSION=2.5.1

RUN dnf -y install \
      python${PYTHON_VERSION} \
      python${PYTHON_VERSION}-pip \
      git jq which procps-ng \
  && dnf clean all

# Create venv
RUN python${PYTHON_VERSION} -m venv /opt/vllm-venv
ENV PATH="/opt/vllm-venv/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install torch + vLLM pinned to 0.11.*
# - CPU wheels:  https://download.pytorch.org/whl/cpu
# - CUDA 12.1:   https://download.pytorch.org/whl/cu121
RUN if [ "${ACCELERATOR}" = "cuda" ]; then \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu121 \
        torch==${TORCH_VERSION}+cu121 torchvision torchaudio ; \
    else \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==${TORCH_VERSION}+cpu torchvision torchaudio ; \
    fi

RUN pip install --no-cache-dir \
      "vllm==${VLLM_VERSION}" \
      "huggingface_hub>=0.24.0" \
      "requests" \
      "hf-transfer"

# Helpful: show versions at build time
RUN python -c "import vllm, torch; print('vllm', vllm.__version__, 'torch', torch.__version__)"

# =============================================================================
# Stage 2: Final – bootc base, systemd units + venv
# =============================================================================
FROM registry.access.redhat.com/ubi9/ubi-bootc:latest

# Install runtime deps (bootc expects rpm-ostree)
RUN rpm-ostree install \
      bash coreutils findutils procps-ng which jq \
      python3.11 shadow-utils \
  && rpm-ostree cleanup -m

# Create app user and dirs
RUN useradd -m -d /opt/rhoim -u 1001 rhoim \
 && mkdir -p /opt/rhoim/bin /opt/rhoim/models /etc/sysconfig \
 && chown -R rhoim:rhoim /opt/rhoim

# Copy venv from builder
COPY --from=builder /opt/vllm-venv /opt/vllm-venv

# Copy your entrypoint
COPY initializer-entrypoint.sh /opt/rhoim/bin/initializer-entrypoint.sh
RUN chmod +x /opt/rhoim/bin/initializer-entrypoint.sh

# Copy systemd unit (adjust path if your repo differs)
# If your unit file is already in the repo, keep the same path here.
COPY deploy/bootc/rhoim-vllm.service /etc/systemd/system/rhoim-vllm.service

# Make sure systemd can execute it
RUN systemctl enable rhoim-vllm.service

EXPOSE 8000

LABEL org.osbuild.bootc=true \
      bootc=true

RUN bootc container lint

CMD ["/sbin/init"]